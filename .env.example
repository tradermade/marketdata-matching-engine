# TraderMade keys (https://tradermade.com). Plans may issue separate streaming
# and REST keys; TRADERMADE_API_KEY is used for both if the specific one is unset.
# With no streaming key the server runs a synthetic feed.
TRADERMADE_WS_API_KEY=
TRADERMADE_REST_API_KEY=
# Address the server listens on.
BIND=127.0.0.1:8080
